{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrendResponse",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "metric_type": { "type": "string" },
        "type": { "type": ["string","null"] },
        "source_id": { "type": ["string","null"] },
        "primary_start_time": { "type": "string" },
        "primary_end_time": { "type": "string" },
        "compare_start_time": { "type": "string" },
        "compare_end_time": { "type": "string" },
        "primary_count": { "type": "integer" },
        "compare_count": { "type": "integer" },
        "difference_absolute": { "type": "integer" },
        "difference_percent": { "type": "number" }
      },
      "required": [
        "metric_type","primary_start_time","primary_end_time",
        "compare_start_time","compare_end_time",
        "primary_count","compare_count","difference_absolute","difference_percent"
      ]
    }
  },
  "required": ["success","data"]
}
